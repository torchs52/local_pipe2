# FROM must be called before other ARGS except for ARG BASE_IMAGE
ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${BASE_IMAGE} AS builder

# For the rest of this Dockerfile
SHELL ["/bin/bash", "-c"]

# Required build args
ARG CMAKE_VERSION=cmake-3.31.8-linux-aarch64
ARG CUDA_ARCH=87
ARG OPEN3D_GIT_REPO=https://github.com/isl-org/Open3D.git
ARG OPEN3D_GIT_TAG=main

# Prevent interactive inputs when installing packages
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Los_Angeles
ENV HOME=/root
ENV SUDO=command
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

RUN rm /var/lib/dpkg/info/libc-bin.*
RUN apt-get clean

# Minimal dependencies for running Docker
# wget    : for downloading
# libgl1  : available on Ubuntu ARM desktop by default
# libgomp1: available on Ubuntu ARM desktop by default
RUN apt-get update && apt-get install -y \
    wget \
    libgl1 \
    libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# Minimal dependencies for building
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    libcurl4-openssl-dev \
    libssl-dev \
    pkg-config \
    ca-certificates \
    software-properties-common \
 && rm -rf /var/lib/apt/lists/*

# CMake
# PWD is /, cmake will be installed to /root/${CMAKE_VERSION}/bin/cmake
RUN CMAKE_VER_NUMBERS=$(echo "${CMAKE_VERSION}" | cut -d"-" -f2) \
 && wget -q https://github.com/Kitware/CMake/releases/download/v${CMAKE_VER_NUMBERS}/${CMAKE_VERSION}.tar.gz \
 && tar -xf ${CMAKE_VERSION}.tar.gz \
 && cp -ar ${CMAKE_VERSION} ${HOME}
ENV PATH=${HOME}/${CMAKE_VERSION}/bin:${PATH}

# Install dependencies before cloning the full Open3D repo for better Docker caching
# Open3D C++ dependencies
COPY ./util/install_deps_ubuntu.sh /root/Open3D/util/
RUN /root/Open3D/util/install_deps_ubuntu.sh assume-yes \
 && rm -rf /var/lib/apt/lists/*
RUN echo ${PATH} \
 && echo "gcc=$(which gcc)" \
 && gcc --version \
 && echo "g++=$(which g++)" \
 && g++ --version
RUN if ! command -v nvcc >/dev/null; then \
      echo "Error: CUDA build requires nvcc. Use JetPack base image (e.g. nvcr.io/nvidia/l4t-jetpack:r36.4.0)." >&2; \
      exit 1; \
    fi \
 && echo "nvcc=$(which nvcc)" \
 && nvcc --version

# Local patches for Open3D main CUDA build issues on JetPack/CUDA 12.6.
COPY ./docker/patches/open3d_main_cuda_shared.patch /root/Open3D/patches/

# Clone Open3D source
RUN git clone --depth 1 --branch ${OPEN3D_GIT_TAG} ${OPEN3D_GIT_REPO} /root/Open3D/src
WORKDIR /root/Open3D/src
RUN if [ "${OPEN3D_GIT_TAG}" = "main" ]; then \
      if grep -q "__shared__ Pair<T, int> blockMin\\[" cpp/open3d/core/nns/kernel/L2Select.cuh; then \
        git apply /root/Open3D/patches/open3d_main_cuda_shared.patch; \
      fi; \
    fi

# Python via deadsnakes PPA (pre-built binaries, no compilation needed)
ARG PYTHON_VERSION=3.12
RUN if [ -z "${PYTHON_VERSION}"  ]; then echo "Error: ARG PYTHON_VERSION  not specified."; exit 1; fi
ENV VIRTUAL_ENV=/opt/open3d-venv
ENV VIRTUAL_ENV_PYTHON=/opt/open3d-venv/bin/python
RUN add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update && apt-get install -y \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-dev \
    python${PYTHON_VERSION}-venv \
 && rm -rf /var/lib/apt/lists/* \
 && /usr/bin/python${PYTHON_VERSION} -m venv "${VIRTUAL_ENV}" \
 && "${VIRTUAL_ENV_PYTHON}" -m ensurepip --upgrade \
 && "${VIRTUAL_ENV_PYTHON}" -m pip install --upgrade pip setuptools wheel
RUN "${VIRTUAL_ENV_PYTHON}" --version

# Python and dependencies
COPY ./python/requirements*.txt /root/Open3D/python/
RUN "${VIRTUAL_ENV_PYTHON}" -m pip install -U -r /root/Open3D/python/requirements.txt \
  -r /root/Open3D/python/requirements_build.txt \
  -r /root/Open3D/python/requirements_test.txt

# Configure
RUN mkdir build \
 && cd build \
 && cmake \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/root/open3d_install \
    -DPython3_EXECUTABLE="${VIRTUAL_ENV_PYTHON}" \
    -DPYTHON_EXECUTABLE="${VIRTUAL_ENV_PYTHON}" \
    -DDEVELOPER_BUILD=OFF \
    -DBUILD_SHARED_LIBS=ON \
    -DBUILD_PYTHON_MODULE=ON \
    -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
    -DBUILD_CUDA_MODULE=ON \
    -DBUILD_COMMON_CUDA_ARCHS=OFF \
    -DBUILD_PYTORCH_OPS=OFF \
    -DBUILD_TENSORFLOW_OPS=OFF \
    -DBUILD_SYCL_MODULE=OFF \
    -DBUILD_GUI=OFF \
    -DBUILD_WEBRTC=OFF \
    -DENABLE_HEADLESS_RENDERING=OFF \
    -DBUNDLE_OPEN3D_ML=OFF \
    -DBUILD_UNIT_TESTS=OFF \
    -DBUILD_EXAMPLES=OFF \
    -DBUILD_BENCHMARKS=OFF \
    -DBUILD_JUPYTER_EXTENSION=OFF \
    -DUSE_BLAS=ON \
    -DUSE_SYSTEM_CURL=ON \
    -DUSE_SYSTEM_OPENSSL=ON \
    ..

# Build only the library / wheel targets we actually consume.
RUN cd build \
 && cmake --build . --parallel "$(nproc)" --target Open3D \
 && cmake --build . --parallel "$(nproc)" --target pybind install-pip-package \
 && cmake --install .
RUN mkdir -p /root/wheels \
 && cp build/lib/python_package/pip_package/*.whl /root/wheels/

FROM scratch AS export

COPY --from=builder /root/open3d_install/ /install/
COPY --from=builder /root/Open3D/src/LICENSE /LICENSE
COPY --from=builder /root/Open3D/src/3rdparty/ /3rdparty/
COPY --from=builder /root/wheels/ /wheels/
